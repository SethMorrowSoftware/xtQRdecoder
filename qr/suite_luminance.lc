-- =====================================================================
-- suite_luminance.lc — luminanceSource byte-math tests (spec §7.3).
-- Defines: command suite_luminance.
-- Requires loaded: qrCompat.lc, luminanceSource.lc.
--
-- Tests ONLY the pure §7.3 conversion via newFromImageData with synthetic
-- 4-byte/pixel data (byte1=0/alpha, byte2=R, byte3=G, byte4=B). The image-OBJECT
-- decode path (newFromData) is covered separately by qr_imageprobe.lc.
-- =====================================================================

-- build raw imageData (0,R,G,B per pixel) from a list "r g b, r g b, ..."
function lum_raw pPixels
   local tRaw, px, r, g, b
   set the itemDelimiter to comma
   put empty into tRaw
   repeat for each item px in pPixels
      put word 1 of px into r
      put word 2 of px into g
      put word 3 of px into b
      put numToByte(0) & numToByte(r) & numToByte(g) & numToByte(b) after tRaw
   end repeat
   return tRaw
end lum_raw

command suite_luminance
   local src, m, tRow

   -- single pixels exercising both branches of §7.3 -----------------
   -- grey (r=g=b) -> r exactly
   put luminanceSource_newFromImageData(1, 1, lum_raw("128 128 128")) into src
   t_eq "grey -> r", src["lum"][0], 128
   -- red 255,0,0 -> (255 + 0 + 0)/4 = 63 (trunc)
   put luminanceSource_newFromImageData(1, 1, lum_raw("255 0 0")) into src
   t_eq "red 255,0,0 -> 63", src["lum"][0], 63
   -- green 0,255,0 -> (0 + 510 + 0)/4 = 127 (trunc of 127.5)
   put luminanceSource_newFromImageData(1, 1, lum_raw("0 255 0")) into src
   t_eq "green 0,255,0 -> 127", src["lum"][0], 127
   -- blue 0,0,255 -> (0 + 0 + 255)/4 = 63 (trunc)
   put luminanceSource_newFromImageData(1, 1, lum_raw("0 0 255")) into src
   t_eq "blue 0,0,255 -> 63", src["lum"][0], 63
   -- white -> 255 ; black -> 0
   put luminanceSource_newFromImageData(1, 1, lum_raw("255 255 255")) into src
   t_eq "white -> 255", src["lum"][0], 255
   put luminanceSource_newFromImageData(1, 1, lum_raw("0 0 0")) into src
   t_eq "black -> 0", src["lum"][0], 0

   -- 2x2 layout / dimensions / row extraction -----------------------
   --   (0,0)=white (1,0)=black / (0,1)=grey100 (1,1)=grey100
   put luminanceSource_newFromImageData(2, 2, \
       lum_raw("255 255 255, 0 0 0, 100 100 100, 100 100 100")) into src
   t_eq "width", luminanceSource_getWidth(src), 2
   t_eq "height", luminanceSource_getHeight(src), 2
   t_eq "lum[0]=255", src["lum"][0], 255
   t_eq "lum[1]=0", src["lum"][1], 0
   t_eq "lum[2]=100", src["lum"][2], 100
   t_eq "lum count", the number of elements of src["lum"], 4

   put luminanceSource_getRow(src, 1) into tRow
   t_eq "row1[0]=100", tRow[0], 100
   t_eq "row1[1]=100", tRow[1], 100

   -- getMatrix returns the flat plane --------------------------------
   put luminanceSource_getMatrix(src) into m
   t_eq "matrix[1]=0", m[1], 0

   -- crop ------------------------------------------------------------
   -- crop the right column (x=1,w=1) of the 2x2 -> [0, 100]
   put luminanceSource_crop(src, 1, 0, 1, 2) into src
   t_eq "crop width", src["width"], 1
   t_eq "crop[0]=0", src["lum"][0], 0
   t_eq "crop[1]=100", src["lum"][1], 100

   -- downsample (§11): a 4x4 grey grid (value = y*16+x) stepped by 2 -> 2x2,
   -- sampling pixels (0,0),(2,0),(0,2),(2,2) = 0,2,32,34.
   local tBig4
   put lum_raw("0 0 0, 1 1 1, 2 2 2, 3 3 3," & \
      "16 16 16, 17 17 17, 18 18 18, 19 19 19," & \
      "32 32 32, 33 33 33, 34 34 34, 35 35 35," & \
      "48 48 48, 49 49 49, 50 50 50, 51 51 51") into tBig4
   put luminanceSource_downsampleRaw(4, 4, tBig4, 2) into src
   t_eq "downsample width", luminanceSource_getWidth(src), 2
   t_eq "downsample height", luminanceSource_getHeight(src), 2
   t_eq "downsample (0,0)=0", src["lum"][0], 0
   t_eq "downsample (2,0)=2", src["lum"][1], 2
   t_eq "downsample (0,2)=32", src["lum"][2], 32
   t_eq "downsample (2,2)=34", src["lum"][3], 34
end suite_luminance
?>
