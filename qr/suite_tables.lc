-- =====================================================================
-- suite_tables.lc - tests for the Stage-6 enum/table modules. Spec section 8.5, section 10.
-- Defines: command suite_tables.
-- Requires loaded: qrCompat.lc, errorCorrectionLevel.lc, mode.lc, dataMask.lc,
--                  formatInformation.lc, version.lc, bitMatrix.lc.
--
-- Verifies the decode-critical constant tables against known QR values.
-- =====================================================================

command suite_tables
   local r, m, v, tBlocks, tThrew, e, tLum

   -- ErrorCorrectionLevel: ordinal/name/bits + the M=00,L=01,H=10,Q=11 field --
   t_eq "ecl_name 0=L", ecl_name(0), "L"
   t_eq "ecl_name 1=M", ecl_name(1), "M"
   t_eq "ecl_name 2=Q", ecl_name(2), "Q"
   t_eq "ecl_name 3=H", ecl_name(3), "H"
   t_eq "ecl_bits L=01", ecl_bits(0), 1
   t_eq "ecl_bits M=00", ecl_bits(1), 0
   t_eq "ecl_bits H=10", ecl_bits(3), 2
   t_eq "ecl_bits Q=11", ecl_bits(2), 3
   t_eq "ecl_forBits 00=M", ecl_forBits(0), 1
   t_eq "ecl_forBits 01=L", ecl_forBits(1), 0
   t_eq "ecl_forBits 10=H", ecl_forBits(2), 3
   t_eq "ecl_forBits 11=Q", ecl_forBits(3), 2

   -- Mode: bits->name and char-count widths per version range -------------
   t_eq "mode 1=NUMERIC", mode_forBits(1), "NUMERIC"
   t_eq "mode 2=ALPHANUMERIC", mode_forBits(2), "ALPHANUMERIC"
   t_eq "mode 4=BYTE", mode_forBits(4), "BYTE"
   t_eq "mode 8=KANJI", mode_forBits(8), "KANJI"
   t_eq "mode 13=HANZI", mode_forBits(13), "HANZI"
   t_eq "mode 0=TERMINATOR", mode_forBits(0), "TERMINATOR"
   t_eq "mode 7=ECI", mode_forBits(7), "ECI"
   t_eq "ccBits NUMERIC v1", mode_charCountBits("NUMERIC", 1), 10
   t_eq "ccBits NUMERIC v10", mode_charCountBits("NUMERIC", 10), 12
   t_eq "ccBits NUMERIC v27", mode_charCountBits("NUMERIC", 27), 14
   t_eq "ccBits ALPHANUMERIC v1", mode_charCountBits("ALPHANUMERIC", 1), 9
   t_eq "ccBits ALPHANUMERIC v40", mode_charCountBits("ALPHANUMERIC", 40), 13
   t_eq "ccBits BYTE v1", mode_charCountBits("BYTE", 1), 8
   t_eq "ccBits BYTE v10", mode_charCountBits("BYTE", 10), 16
   t_eq "ccBits KANJI v1", mode_charCountBits("KANJI", 1), 8
   t_eq "ccBits KANJI v27", mode_charCountBits("KANJI", 27), 12
   t_eq "ccBits TERMINATOR", mode_charCountBits("TERMINATOR", 1), 0

   -- bad mode bits throws -------------------------------------------------
   put false into tThrew
   try
      get mode_forBits(6)
   catch e
      put true into tThrew
   end try
   t_eq "mode 6 throws", tThrew, true

   -- DataMask: spot-check each predicate at known cells ------------------
   t_eq "mask0 (0,0)", dataMask_isMasked(0, 0, 0), true
   t_eq "mask0 (0,1)", dataMask_isMasked(0, 0, 1), false
   t_eq "mask1 (0,j)", dataMask_isMasked(1, 0, 5), true
   t_eq "mask1 (1,j)", dataMask_isMasked(1, 1, 5), false
   t_eq "mask2 (i,0)", dataMask_isMasked(2, 4, 0), true
   t_eq "mask2 (i,1)", dataMask_isMasked(2, 4, 1), false
   t_eq "mask3 (0,0)", dataMask_isMasked(3, 0, 0), true
   t_eq "mask3 (1,1)", dataMask_isMasked(3, 1, 1), false
   t_eq "mask4 (0,0)", dataMask_isMasked(4, 0, 0), true
   t_eq "mask5 (0,0)", dataMask_isMasked(5, 0, 0), true
   t_eq "mask5 (1,1)", dataMask_isMasked(5, 1, 1), false
   t_eq "mask6 (0,0)", dataMask_isMasked(6, 0, 0), true
   t_eq "mask6 (1,1)", dataMask_isMasked(6, 1, 1), true
   t_eq "mask7 (0,0)", dataMask_isMasked(7, 0, 0), true

   -- DataMask unmask is an involution (apply twice = identity) -----------
   put bitMatrix_new(21) into m
   bitMatrix_set m, 3, 4
   dataMask_unmask m, 21, 3
   dataMask_unmask m, 21, 3
   t_eq "unmask involution keeps (3,4)", bitMatrix_get(m, 3, 4), true
   t_eq "unmask involution (5,5) off", bitMatrix_get(m, 5, 5), false

   -- FormatInformation: decode known masked sequences --------------------
   -- exact stored sequence for dataBits 0 (M, mask 0) is 21522 (0x5412^bch(0)=0x5412)
   put fmt_decode(21522, 21522) into r
   t_eq "fmt exact: ecLevel M", r["ecLevel"], 1
   t_eq "fmt exact: dataMask 0", r["dataMask"], 0
   -- dataBits 21 -> seq 597. 21 = 10101 -> ec field=10=H(3), mask=101=5
   put fmt_decode(597, 597) into r
   t_eq "fmt 597 ecLevel H(3)", r["ecLevel"], 3
   t_eq "fmt 597 dataMask 5", r["dataMask"], 5
   -- one-bit error still decodes (Hamming <=3): flip a bit in 21522
   put fmt_decode((21522 bitXor 1), (21522 bitXor 1)) into r
   t_eq "fmt 1-bit err ecLevel M", r["ecLevel"], 1
   t_eq "fmt 1-bit err dataMask 0", r["dataMask"], 0

   -- Version: dimensions, totals, alignment, version-info ----------------
   t_eq "v1 dimension 21", ver_getDimensionForVersion(1), 21
   t_eq "v7 dimension 45", ver_getDimensionForVersion(7), 45
   t_eq "v40 dimension 177", ver_getDimensionForVersion(40), 177
   t_eq "v1 align empty", ver_getAlignmentCenters(1), empty
   t_eq "v2 align 6,18", ver_getAlignmentCenters(2), "6,18"
   t_eq "v7 align 6,22,38", ver_getAlignmentCenters(7), "6,22,38"
   -- ec codewords per block
   t_eq "v1-L ecw 7", ver_getEcCodewordsPerBlock(1, 0), 7
   t_eq "v1-H ecw 17", ver_getEcCodewordsPerBlock(1, 3), 17
   -- total data codewords (known: v1-L = 19, v1-M = 16, v1-H = 9)
   t_eq "v1-L data 19", ver_getTotalDataCodewords(1, 0), 19
   t_eq "v1-M data 16", ver_getTotalDataCodewords(1, 1), 16
   t_eq "v1-H data 9", ver_getTotalDataCodewords(1, 3), 9
   -- v5-Q has two block groups (2x15 + 2x16 = 62 data)
   t_eq "v5-Q data 62", ver_getTotalDataCodewords(5, 2), 62
   -- provisional version from dimension
   t_eq "provVer dim 21 = 1", ver_getProvisionalVersionForDimension(21), 1
   t_eq "provVer dim 45 = 7", ver_getProvisionalVersionForDimension(45), 7
   -- version-info decode (exact + 3-bit tolerant). v7 pattern = 0x07C94 = 31892
   t_eq "decodeVer 31892 = 7", ver_decodeVersionInformation(31892), 7
   t_eq "decodeVer 31892^7 = 7", ver_decodeVersionInformation(31892 bitXor 7), 7
   -- v40 pattern 0x28C69 = 167017
   t_eq "decodeVer 167017 = 40", ver_decodeVersionInformation(167017), 40
end suite_tables
?>
