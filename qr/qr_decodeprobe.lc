-- =====================================================================
-- qr_decodeprobe.lc — end-to-end real-image decode probe.
--
-- This is the first test of the WHOLE public pipeline on an actual raster image
-- (not a synthetic in-memory BitMatrix): it embeds a known PNG of a v1 QR code
-- for "HI", loads every library module, and calls qrDecodeFromData -- which runs
--   image object -> the imageData -> luminanceSource (greyscale, §7)
--   -> hybridBinarizer -> binaryBitmap -> detector -> decoder -> text.
--
-- DEPLOY: upload the qr/ folder and open this file:
--     https://yoursite/qr/qr_decodeprobe.lc
-- Unlike qr_tester.lc this is a single end-to-end assertion, not the unit grid;
-- it is the bridge from "synthetic matrices pass" to "real photos decode".
--
-- The embedded PNG was generated by the Python `qrcode` library and its full
-- decode (luminance -> threshold -> detector -> "HI") was verified in Python
-- before this page was written.
-- =====================================================================

local tBase, tReady, tFiles, tF, tMissing
local sHTML
-- ---- directory resolution (same approach as qr_tester.lc) ----------------
function qrDirOf pPath
   if pPath is empty then return empty
   set the itemDelimiter to "/"
   if the number of items of pPath < 2 then return empty
   delete the last item of pPath
   return pPath
end qrDirOf

function qrFindBase
   local tCands, d
   put qrDirOf($_SERVER["SCRIPT_FILENAME"]) & cr after tCands
   put qrDirOf($_SERVER["PATH_TRANSLATED"]) & cr after tCands
   if ($_SERVER["DOCUMENT_ROOT"] is not empty) and ($_SERVER["SCRIPT_NAME"] is not empty) then
      put qrDirOf($_SERVER["DOCUMENT_ROOT"] & $_SERVER["SCRIPT_NAME"]) & cr after tCands
   end if
   put the defaultFolder & cr after tCands
   repeat for each line d in tCands
      if (d is not empty) and (there is a file (d & "/qrCompat.lc")) then
         return d
      end if
   end repeat
   return empty
end qrFindBase

command out s
   put s & cr after sHTML
end out

function htmlEsc s
   replace "&" with "&amp;" in s
   replace "<" with "&lt;" in s
   replace ">" with "&gt;" in s
   replace quote with "&quot;" in s
   return s
end htmlEsc

-- the known-good "HI" v1 QR PNG (base64), 296x296, generated by Python qrcode
function hiPngBase64
   local b
   put "iVBORw0KGgoAAAANSUhEUgAAASgAAAEoCAAAAADObDPFAAACMklEQVR42u3cSxKDIBAFQO9/6eQEiTI8" after b
   put "FKTfjkhFbDdTfDw+cikHAlCgQIECBUpAgQIFChQoUAIKFChQoEAJKFCgQIECBUpAgQIFChQoUAIKFChQ" after b
   put "oEAJKFCgQIECBUpAgQIFChQoAQUKFChQoEAJKFCgXgJ1FPPrf85+T90PFChQoECBAgVqFqhq/9YH6r0f" after b
   put "KFCgQIECBQrUrFBnBd/ZwFsL0977gQIFChQoUKBArQ51tRAFBQoUKFCgQIEC9b8/KFCgQIECBQrUblDV" after b
   put "/tXCND0+UKBAgQIFChSou6GqG+Sr7e1OLoACBQoUKFCgXgeVTurB4uMCBQoUKFCgQIEaPHHX2q5O4KUn" after b
   put "+ECBAgUKFChQoJ6C6gVIt9NgoECBAgUKFChQd0FVF0Kr11tfHChQoECBAgUK1NNQacj0dVCgQIECBQoU" after b
   put "qFmhqguW6Q9BVMcDChQoUKBAgQI1a8FZLUivvhhQoECBAgUKFKhVodIfbEhtyAcFChQoUKBAgVoFqrf/" after b
   put "qIIzVhiDAgUKFChQoEANhkovbI468AgKFChQoECBArU61CiQZTbkgwIFChQoUKBAhQvO3oOO21TmoECB" after b
   put "AgUKFKjXQFX7t25Aq8KBAgUKFChQoEC9ZUP+dgUnKFCgQIECBQrUZgEFChQoUKBACShQoECBAgVKQIEC" after b
   put "BQoUKAEFChQoUKBACShQoECBAgVKQIECBQoUKAEFChQoUKBACShQoECBAiWgQIECBQoUKAEFCtQk+QIC" after b
   put "0TRWs/xo2gAAAABJRU5ErkJggg==" after b
   return b
end hiPngBase64

function css
   local c
   put "body{font:15px/1.5 -apple-system,Segoe UI,Roboto,Arial,sans-serif;margin:0;background:#0f1117;color:#e6e6e6}" & cr after c
   put ".wrap{max-width:760px;margin:0 auto;padding:26px 20px}" & cr after c
   put "h1{font-size:21px;margin:0 0 14px}" & cr after c
   put ".banner{padding:15px 18px;border-radius:10px;font-size:18px;font-weight:600;margin:16px 0}" & cr after c
   put ".banner.ok{background:#0f3d2e;color:#5ee6a8;border:1px solid #1c6b4f}" & cr after c
   put ".banner.bad{background:#3d1414;color:#ff8a8a;border:1px solid #6b1c1c}" & cr after c
   put ".panel{background:#161922;border:1px solid #232734;border-radius:10px;padding:14px 16px;margin:14px 0}" & cr after c
   put "table{width:100%;border-collapse:collapse;font-size:13.5px}" & cr after c
   put "th,td{text-align:left;padding:6px 10px;border-bottom:1px solid #232734;vertical-align:top}" & cr after c
   put "code{background:#1a1d27;padding:1px 6px;border-radius:4px;color:#cdd6f4}" & cr after c
   put ".st{font-weight:700}.ok .st{color:#5ee6a8}.bad .st{color:#ff8a8a}" & cr after c
   return c
end css

command renderResult pText, pError, pSteps
   out "<!DOCTYPE html><html lang='en'><head><meta charset='utf-8'>"
   out "<meta name='viewport' content='width=device-width, initial-scale=1'>"
   out "<title>xtQRdecoder -- real-image decode probe</title>"
   out "<style>" & css() & "</style></head><body><div class='wrap'>"
   out "<h1>xtQRdecoder -- real-image decode probe</h1>"
   out "<p>Decodes an embedded PNG of a version-1 QR for <code>HI</code> through the full public pipeline (<code>qrDecodeFromData</code>: image &rarr; luminance &rarr; binarizer &rarr; detector &rarr; decoder).</p>"
   if (pError is empty) and (pText = "HI") then
      out "<div class='banner ok'>&#10003; Decoded &ldquo;" & htmlEsc(pText) & "&rdquo; &mdash; the real-image pipeline works on this engine.</div>"
   else if pError is not empty then
      out "<div class='banner bad'>&#10007; Decode failed: <code>" & htmlEsc(pError) & "</code></div>"
   else
      out "<div class='banner bad'>&#10007; Decoded &ldquo;" & htmlEsc(pText) & "&rdquo; but expected &ldquo;HI&rdquo;.</div>"
   end if
   out "<div class='panel'><table><tr><th>Step</th><th>Status</th><th>Detail</th></tr>"
   out pSteps
   out "</table></div>"
   out "<p style='color:#6b7280;font-size:12px'>Generated by qr_decodeprobe.lc &middot; <a href='qr_tester.lc'>unit test console &rarr;</a></p>"
   out "</div></body></html>"
end renderResult

command stepRow @pSteps, pName, pState, pDetail
   put "<tr class='" & pState & "'><td>" & htmlEsc(pName) & \
       "</td><td class='st'>" & toupper(pState) & "</td><td><code>" & \
       htmlEsc(pDetail) & "</code></td></tr>" & cr after pSteps
end stepRow

-- the setup page shown when library files are missing
command renderMissing
   out "<!DOCTYPE html><html><head><meta charset='utf-8'><title>xtQRdecoder setup</title>"
   out "<style>" & css() & "</style></head><body><div class='wrap'>"
   out "<h1>xtQRdecoder decode probe -- setup needed</h1>"
   out "<div class='banner bad'>Missing library files; upload the whole qr/ folder.</div>"
   out "<div class='panel'><pre><code>" & htmlEsc(tMissing) & "</code></pre></div>"
   out "</div></body></html>"
end renderMissing

-- run the end-to-end decode of the embedded PNG and render the result page.
-- Kept as a handler (not loose code) so the main block stays a simple dispatch,
-- mirroring qr_tester.lc's proven structure.
command runDecode
   local tPng, tResult, tText, tError, tSteps, tLen, e
   put empty into tSteps
   put base64Decode(hiPngBase64()) into tPng
   put the number of bytes of tPng into tLen
   stepRow tSteps, "decode embedded PNG (base64)", "ok", tLen & " bytes"

   put empty into tError
   put empty into tText
   try
      put qrDecodeResult(tPng, empty) into tResult
      put tResult["error"] into tError
      put tResult["text"] into tText
      if tError is empty then
         stepRow tSteps, "qrDecodeFromData", "ok", "version " & tResult["version"] & ", EC " & tResult["ecLevel"] & ", mask " & tResult["mask"]
         stepRow tSteps, "decoded text", "ok", tText
      else
         stepRow tSteps, "qrDecodeFromData", "bad", tError
      end if
   catch e
      put e into tError
      stepRow tSteps, "qrDecodeFromData (exception)", "bad", e
   end try

   renderResult tText, tError, tSteps
end runDecode


-- =========================  main  =========================================
put qrFindBase() into tBase
put "qrCompat.lc,genericGF.lc,genericGFPoly.lc,reedSolomonDecoder.lc,bitArray.lc,bitMatrix.lc,bitSource.lc,luminanceSource.lc,globalHistogramBinarizer.lc,hybridBinarizer.lc,binaryBitmap.lc,errorCorrectionLevel.lc,mode.lc,dataMask.lc,formatInformation.lc,version.lc,characterSetECI.lc,dataBlock.lc,decodedBitStreamParser.lc,bitMatrixParser.lc,decoder.lc,mathUtils.lc,resultPoint.lc,perspectiveTransform.lc,gridSampler.lc,finderPatternFinder.lc,alignmentPatternFinder.lc,detector.lc,qrCodeReader.lc,qrReader.lc" into tFiles
set the itemDelimiter to comma
put empty into tMissing
if tBase is empty then
   put "(could not locate the script directory)" into tMissing
else
   repeat for each item tF in tFiles
      if there is not a file (tBase & "/" & tF) then
         put tF & cr after tMissing
      end if
   end repeat
end if

-- load everything by absolute path. Mirror qr_tester.lc EXACTLY: a single
-- `if tMissing is empty then include... end if` (positive `then` branch, no
-- `else`), because `include` is a compile-time directive and the proven console
-- guards it this way.
put false into tReady
if tMissing is empty then
   include (tBase & "/qrCompat.lc")
   include (tBase & "/genericGF.lc")
   include (tBase & "/genericGFPoly.lc")
   include (tBase & "/reedSolomonDecoder.lc")
   include (tBase & "/bitArray.lc")
   include (tBase & "/bitMatrix.lc")
   include (tBase & "/bitSource.lc")
   include (tBase & "/luminanceSource.lc")
   include (tBase & "/globalHistogramBinarizer.lc")
   include (tBase & "/hybridBinarizer.lc")
   include (tBase & "/binaryBitmap.lc")
   include (tBase & "/errorCorrectionLevel.lc")
   include (tBase & "/mode.lc")
   include (tBase & "/dataMask.lc")
   include (tBase & "/formatInformation.lc")
   include (tBase & "/version.lc")
   include (tBase & "/characterSetECI.lc")
   include (tBase & "/dataBlock.lc")
   include (tBase & "/decodedBitStreamParser.lc")
   include (tBase & "/bitMatrixParser.lc")
   include (tBase & "/decoder.lc")
   include (tBase & "/mathUtils.lc")
   include (tBase & "/resultPoint.lc")
   include (tBase & "/perspectiveTransform.lc")
   include (tBase & "/gridSampler.lc")
   include (tBase & "/finderPatternFinder.lc")
   include (tBase & "/alignmentPatternFinder.lc")
   include (tBase & "/detector.lc")
   include (tBase & "/qrCodeReader.lc")
   include (tBase & "/qrReader.lc")
   put true into tReady
end if

-- render: the decode result if everything loaded, else the setup page
put empty into sHTML
if tReady then
   runDecode
else
   renderMissing
end if
put sHTML
?>
