-- =====================================================================
-- suite_genericGFPoly.lc - polynomial-over-GF(256) tests (spec section 10.3).
-- Defines: command suite_genericGFPoly.
-- Requires loaded: qrCompat.lc, genericGF.lc, genericGFPoly.lc.
--
-- Polynomials are 0-based coefficient arrays, index 0 = highest degree.
-- Helper poly3 builds a small dense array literal for inputs.
-- =====================================================================

-- build a dense 0-based array from up to 5 explicit coefficients
function poly3 a, b, c, d, e
   local t, n
   put 0 into n
   put a into t[0]
   if b is not empty then put b into t[1]
   if c is not empty then put c into t[2]
   if d is not empty then put d into t[3]
   if e is not empty then put e into t[4]
   return t
end poly3

command suite_genericGFPoly
   local p, q, r, res, tmp

   -- zero / one ------------------------------------------------------
   t_eq "poly_isZero(zero)", poly_isZero(poly_zero()), true
   t_eq "poly_isZero(one)", poly_isZero(poly_one()), false
   t_eq "poly_degree(one)", poly_degree(poly_one()), 0

   -- poly_new strips leading (high-degree) zeros ---------------------
   put poly_new(poly3(0, 0, 5, 3, empty)) into p     -- [0,0,5,3] -> [5,3]
   t_eq "poly_new strip length", the number of elements of p, 2
   t_eq "poly_new strip [0]", p[0], 5
   t_eq "poly_new strip [1]", p[1], 3
   put poly_new(poly3(0, 0, 0, empty, empty)) into p -- all zero -> [0]
   t_eq "poly_new all-zero length", the number of elements of p, 1
   t_eq "poly_new all-zero isZero", poly_isZero(p), true

   -- degree / getCoefficient (p = x^2 + 2x + 3) ----------------------
   put poly3(1, 2, 3, empty, empty) into p
   t_eq "poly_degree", poly_degree(p), 2
   t_eq "getCoefficient x^2", poly_getCoefficient(p, 2), 1
   t_eq "getCoefficient x^1", poly_getCoefficient(p, 1), 2
   t_eq "getCoefficient x^0", poly_getCoefficient(p, 0), 3

   -- evaluateAt (p = x^2 + 2x + 3) -----------------------------------
   t_eq "evaluateAt 0", poly_evaluateAt(p, 0), 3
   t_eq "evaluateAt 1 (1^2^3)", poly_evaluateAt(p, 1), 0
   t_eq "evaluateAt 2", poly_evaluateAt(p, 2), 3

   -- addOrSubtract ---------------------------------------------------
   put poly3(1, 2, 3, empty, empty) into p
   put poly3(2, 3, empty, empty, empty) into q
   put poly_addOrSubtract(p, q) into res            -- [1,0,0]
   t_eq "add length", the number of elements of res, 3
   t_eq "add [0]", res[0], 1
   t_eq "add [1]", res[1], 0
   t_eq "add [2]", res[2], 0
   put poly_addOrSubtract(p, p) into res            -- self -> zero
   t_eq "add self -> zero", poly_isZero(res), true

   -- multiply ((x+1)(x+1) = x^2 + 1) ---------------------------------
   put poly3(1, 1, empty, empty, empty) into p
   put poly_multiply(p, p) into res                 -- [1,0,1]
   t_eq "mul length", the number of elements of res, 3
   t_eq "mul [0]", res[0], 1
   t_eq "mul [1]", res[1], 0
   t_eq "mul [2]", res[2], 1

   -- multiplyScalar (p = x^2+2x+3) * 2 = [2,4,6] ---------------------
   put poly3(1, 2, 3, empty, empty) into p
   put poly_multiplyScalar(p, 2) into res
   t_eq "scalar [0]", res[0], 2
   t_eq "scalar [1]", res[1], 4
   t_eq "scalar [2]", res[2], 6
   t_eq "scalar by 0 -> zero", poly_isZero(poly_multiplyScalar(p, 0)), true

   -- multiplyByMonomial ((x^2+2x+3) * x^2) = [1,2,3,0,0] -------------
   put poly_multiplyByMonomial(p, 2, 1) into res
   t_eq "monomial length", the number of elements of res, 5
   t_eq "monomial [0]", res[0], 1
   t_eq "monomial [3]", res[3], 0
   t_eq "monomial [4]", res[4], 0

   -- divide ((x^2+1) / (x+1) = (x+1) r 0) ----------------------------
   put poly3(1, 0, 1, empty, empty) into p
   put poly3(1, 1, empty, empty, empty) into q
   put poly_divide(p, q) into res
   put res["q"] into tmp
   t_eq "divide quotient len", the number of elements of tmp, 2
   t_eq "divide quotient [0]", tmp[0], 1
   t_eq "divide quotient [1]", tmp[1], 1
   put res["r"] into tmp
   t_eq "divide remainder isZero", poly_isZero(tmp), true
end suite_genericGFPoly
?>
