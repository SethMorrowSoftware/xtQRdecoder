-- =====================================================================
-- suite_decoder.lc — end-to-end decode of a real QR matrix. Spec §10.
-- Defines: command suite_decoder.
-- Requires loaded: the full decode stack (qrCompat..decoder).
--
-- THE FIXTURE: an authoritative version-1-L QR matrix encoding "HI" (mask 0),
-- generated by the Python `qrcode` library and independently verified — its
-- format bits (30660), 19 data codewords, and final text "HI" were all
-- confirmed in Python through the SAME logic this xTalk implements.
-- This is the first true bit-matrix -> text test (no image needed).
-- =====================================================================

-- build the 21x21 BitMatrix from the comma-separated row strings
function dec_fixtureHI
   local rows, m, r, c, rowStr, tDim
   put \
"111111100010101111111,100000100000101000001,101110101010001011101,101110100000101011101,101110100101101011101,100000100111001000001,111111101010101111111,000000001010000000000,111011111010111000100,000111000001010101001,000001110111011100110,101111001001110111010,010000111001011100101,000000001010001000101,111111101110100010001,100000101010001000100,101110101110101010101,101110100001010101010,101110101001011101101,100000101001110111011,111111101111011101101" \
      into rows
   put 21 into tDim
   put bitMatrix_new(tDim) into m
   set the itemDelimiter to comma
   repeat with r = 0 to (tDim - 1)
      put (item (r + 1) of rows) into rowStr
      repeat with c = 0 to (tDim - 1)
         if (char (c + 1) of rowStr) = "1" then
            bitMatrix_set m, c, r       -- x=c (column), y=r (row)
         end if
      end repeat
   end repeat
   return m
end dec_fixtureHI

command suite_decoder
   local m, parser, tFmt, tVer, tCw, tRes

   put dec_fixtureHI() into m
   t_eq "fixture dimension", bitMatrix_getHeight(m), 21

   -- BitMatrixParser: format information (copy 1 decodes to EC=L, mask 0) ----
   put bmp_new(m) into parser
   put bmp_readFormatInformation(parser) into tFmt
   t_eq "format ecLevel L(0)", tFmt["ecLevel"], 0
   t_eq "format dataMask 0", tFmt["dataMask"], 0

   -- version from dimension ------------------------------------------------
   put bmp_readVersion(parser) into tVer
   t_eq "version 1", tVer, 1

   -- read codewords after unmasking (mask 0) -------------------------------
   -- replicate the decoder's unmask-then-read on a copy
   local m2
   put dec_fixtureHI() into m2
   dataMask_unmask m2, 21, 0
   local parser2
   put bmp_new(m2) into parser2
   put bmp_readCodewords(parser2, 1) into tCw
   t_eq "codeword count >= 26", (the number of elements of tCw >= 26), true
   t_eq "codeword[0] = 32", tCw[0], 32
   t_eq "codeword[1] = 19", tCw[1], 19
   t_eq "codeword[2] = 15", tCw[2], 15
   t_eq "codeword[3] = 0", tCw[3], 0
   t_eq "codeword[4] = 236", tCw[4], 236
   t_eq "codeword[5] = 17", tCw[5], 17

   -- FULL end-to-end: matrix -> text ---------------------------------------
   put dec_decode(m) into tRes
   t_eq "decode error empty", tRes["error"], empty
   t_eq "decode text = HI", tRes["text"], "HI"
   t_eq "decode ecLevel L", tRes["ecLevel"], "L"
   t_eq "decode version 1", tRes["version"], 1
   t_eq "decode mask 0", tRes["mask"], 0

   -- robustness: corrupt 2 data modules; RS (t=3 for 7 EC) must still recover
   local m3, x, y, flipped
   put dec_fixtureHI() into m3
   -- flip two arbitrary data-area modules (interior, away from function pat.)
   bitMatrix_flip m3, 12, 12
   bitMatrix_flip m3, 14, 12
   put dec_decode(m3) into tRes
   t_eq "decode with 2 errors -> HI", tRes["text"], "HI"
end suite_decoder
?>
