-- =====================================================================
-- suite_qrCompat.lc - qrCompat test cases (presentation-agnostic).
--
-- Defines:  command suite_qrCompat
-- It reports each case by calling a command the RUNNER must provide:
--      command t_eq pName, pGot, pExp
-- and assumes the qrCompat.lc handlers (qr_u32, qr_shl, ...) are already loaded.
--
-- Runners: qr_tester.lc (web/HTML) - and any future CLI/CI runner - include
-- both qrCompat.lc and this file, define t_eq, then call suite_qrCompat.
--
-- All expected values are hand-computed and cross-checked against Java/ZXing
-- semantics (signed 32-bit two's-complement, >>> unsigned shift).
-- =====================================================================

command suite_qrCompat
   local tA, tB, tSrc, tDst

   -- qr_u32 ---------------------------------------------------------------
   t_eq "qr_u32 in-range", qr_u32(5), 5
   t_eq "qr_u32 zero", qr_u32(0), 0
   t_eq "qr_u32 -1 -> 0xFFFFFFFF", qr_u32(-1), 4294967295
   t_eq "qr_u32 -16777216 -> 0xFF000000", qr_u32(-16777216), 4278190080
   t_eq "qr_u32 2^32 -> 0", qr_u32(4294967296), 0
   t_eq "qr_u32 already-max", qr_u32(4294967295), 4294967295

   -- qr_u8 ----------------------------------------------------------------
   t_eq "qr_u8 300", qr_u8(300), 44
   t_eq "qr_u8 255", qr_u8(255), 255
   t_eq "qr_u8 256", qr_u8(256), 0

   -- qr_shl  (Java <<) ----------------------------------------------------
   t_eq "qr_shl 1<<0", qr_shl(1, 0), 1
   t_eq "qr_shl 1<<5", qr_shl(1, 5), 32
   t_eq "qr_shl 1<<31", qr_shl(1, 31), 2147483648
   t_eq "qr_shl 255<<24", qr_shl(255, 24), 4278190080
   t_eq "qr_shl 0xFFFFFFFF<<1 (low bits survive)", qr_shl(4294967295, 1), 4294967294

   -- qr_uShr  (Java >>>) --------------------------------------------------
   t_eq "qr_uShr 0xFF000000>>>24", qr_uShr(4278190080, 24), 255
   t_eq "qr_uShr 1>>>1", qr_uShr(1, 1), 0
   t_eq "qr_uShr 0xFFFFFFFF>>>28", qr_uShr(4294967295, 28), 15
   t_eq "qr_uShr x>>>0", qr_uShr(12345, 0), 12345

   -- qr_aShr  (Java >>, sign-extending) -----------------------------------
   t_eq "qr_aShr positive", qr_aShr(255, 1), 127
   t_eq "qr_aShr -16777216>>24 = -1", qr_aShr(4278190080, 24), 4294967295
   t_eq "qr_aShr -1>>1 = -1", qr_aShr(4294967295, 1), 4294967295
   t_eq "qr_aShr -2>>1 = -1", qr_aShr(4294967294, 1), 4294967295

   -- qr_numberOfTrailingZeros ---------------------------------------------
   t_eq "ntz 0", qr_numberOfTrailingZeros(0), 32
   t_eq "ntz 1", qr_numberOfTrailingZeros(1), 0
   t_eq "ntz 8", qr_numberOfTrailingZeros(8), 3
   t_eq "ntz 6", qr_numberOfTrailingZeros(6), 1
   t_eq "ntz 96", qr_numberOfTrailingZeros(96), 5
   t_eq "ntz 0x80000000", qr_numberOfTrailingZeros(2147483648), 31

   -- qr_hashCode ----------------------------------------------------------
   t_eq "qr_hashCode empty", qr_hashCode(""), 0
   t_eq "qr_hashCode a", qr_hashCode("a"), 97
   t_eq "qr_hashCode ab", qr_hashCode("ab"), 3105
   t_eq "qr_hashCode abc", qr_hashCode("abc"), 96354

   -- qr_floatToIntBits ----------------------------------------------------
   t_eq "f2ib 0.0", qr_floatToIntBits(0.0), 0
   t_eq "f2ib 1.0", qr_floatToIntBits(1.0), 1065353216
   t_eq "f2ib 2.0", qr_floatToIntBits(2.0), 1073741824
   t_eq "f2ib -1.0", qr_floatToIntBits(-1.0), 3212836864

   -- qr_byteAt ------------------------------------------------------------
   t_eq "qr_byteAt A@0", qr_byteAt("ABC", 0), 65
   t_eq "qr_byteAt C@2", qr_byteAt("ABC", 2), 67

   -- qr_fillArray --------------------------------------------------------
   put qr_fillArray(0, 3, 0) into tA
   t_eq "qr_fillArray size 3", the number of elements of tA, 3
   t_eq "qr_fillArray value", tA[2], 0
   put qr_fillArray(0, 0, 7) into tB
   t_eq "qr_fillArray quirk size 1", the number of elements of tB, 1
   t_eq "qr_fillArray quirk value", tB[0], 7

   -- qr_arraycopy ---------------------------------------------------------
   put 10 into tSrc[0]
   put 11 into tSrc[1]
   put 12 into tSrc[2]
   put 13 into tSrc[3]
   qr_arraycopy tSrc, 1, tDst, 5, 2
   t_eq "qr_arraycopy dst[5]", tDst[5], 11
   t_eq "qr_arraycopy dst[6]", tDst[6], 12
   t_eq "qr_arraycopy count", the number of elements of tDst, 2
end suite_qrCompat
?>
