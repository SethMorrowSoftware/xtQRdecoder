-- =====================================================================
-- suite_detector.lc - end-to-end DETECTOR test on a synthetic "photo".
-- Defines: commands suite_detector, suite_detectorV2. Requires loaded: the full stack plus
--   mathUtils, resultPoint, perspectiveTransform, gridSampler,
--   finderPatternFinder, alignmentPatternFinder, detector, decoder.
--
-- THE FIXTURE: the real version-1 "HI" QR matrix (from suite_decoder's
-- dec_fixtureHI) upscaled x4 with a 4-module white quiet zone -> a clean,
-- axis-aligned 116x116 "image". This exercises the WHOLE detector
-- (finderPatternFinder -> module size -> computeDimension -> createTransform
-- -> gridSampler) with no real photo, then decodes the sampled matrix to "HI".
--
-- Expected finder centres, dimension, and the sampled==original equality were
-- all independently derived in Python from the ZXing logic before this test.
-- =====================================================================

-- upscale a square BitMatrix by pScale with a pBorder-module white quiet zone
function det_upscale pSrc, pScale, pBorder
   local tDim, tBig, tBigDim, r, c, yy, xx
   put bitMatrix_getWidth(pSrc) into tDim
   put ((tDim + (2 * pBorder)) * pScale) into tBigDim
   put bitMatrix_new(tBigDim) into tBig
   repeat with r = 0 to (tDim - 1)
      repeat with c = 0 to (tDim - 1)
         if bitMatrix_get(pSrc, c, r) then
            repeat with yy = ((r + pBorder) * pScale) to (((r + pBorder + 1) * pScale) - 1)
               repeat with xx = ((c + pBorder) * pScale) to (((c + pBorder + 1) * pScale) - 1)
                  bitMatrix_set tBig, xx, yy
               end repeat
            end repeat
         end if
      end repeat
   end repeat
   return tBig
end det_upscale

command suite_detector
   local tHI, tBig, tInfo, tTL, tTR, tBL, tDetRes, tBits, tDecRes
   local x, y, tEqual

   put dec_fixtureHI() into tHI
   put det_upscale(tHI, 4, 4) into tBig
   t_eq "synthetic image is 116x116", bitMatrix_getWidth(tBig), 116

   -- FinderPatternFinder: 3 corner centres (scale 4, border 4)
   put fpf_find(tBig, empty) into tInfo
   put tInfo["tl"] into tTL
   put tInfo["tr"] into tTR
   put tInfo["bl"] into tBL
   t_eq "finder TL x = 30", tTL["x"], 30
   t_eq "finder TL y = 30", tTL["y"], 30
   t_eq "finder TR x = 86", tTR["x"], 86
   t_eq "finder TR y = 30", tTR["y"], 30
   t_eq "finder BL x = 30", tBL["x"], 30
   t_eq "finder BL y = 86", tBL["y"], 86
   t_eq "finder TL module size = 4", tTL["ms"], 4

   -- full Detector: dimension 21, sampled square matrix equals the original HI
   put dt_detect(tBig, empty) into tDetRes
   t_eq "detect dimension = 21", tDetRes["dimension"], 21
   put tDetRes["bits"] into tBits
   t_eq "sampled width = 21", bitMatrix_getWidth(tBits), 21
   put true into tEqual
   repeat with y = 0 to 20
      repeat with x = 0 to 20
         if bitMatrix_get(tBits, x, y) <> bitMatrix_get(tHI, x, y) then
            put false into tEqual
         end if
      end repeat
   end repeat
   t_eq "sampled matrix == original HI", tEqual, true

   -- end-to-end: detect -> decode -> "HI"
   put dec_decode(tBits) into tDecRes
   t_eq "decode error empty", tDecRes["error"], empty
   t_eq "decode text = HI", tDecRes["text"], "HI"
   t_eq "decode version = 1", tDecRes["version"], 1
   t_eq "decode ecLevel = L", tDecRes["ecLevel"], "L"
end suite_detector

-- ---------------------------------------------------------------------------
-- VERSION 2 fixture: a real v2-M QR matrix for "HELLO WORLD" (25x25, one
-- alignment pattern centred at module (18,18)), generated by the Python
-- `qrcode` library. This is the first test that exercises the v2+ ALIGNMENT
-- path -- alignmentPatternFinder + the alignment branch of dt_detect -- which
-- the v1 "HI" fixture never touches. Every expected value below (finder
-- centres, dimension 25, alignment pixel (90,90), and the decoded text) was
-- independently derived in Python from the ZXing logic before this test.
-- ---------------------------------------------------------------------------
function dec_fixtureHelloV2
   local rows, m, r, c, rowStr
   put \
"1111111000101010001111111,1000001011110100001000001,1011101000011001001011101,1011101001110100101011101,1011101011110100101011101,1000001000100011101000001,1111111010101010101111111,0000000000101001000000000,1010101000011000100010010,0011110000101101110010110,1000101000011011101001100,1110010100001110100011001,1011101011100011001011111,0100000001110011000100001,1010101011100100010011000,0111010110110001011001010,1010101010101000111110001,0000000010111101100010101,1111111001111010101011100,1000001001001110100010100,1011101011110011111110111,1011101001010011101010010,1011101010100101001010101,1000001000010000010100111,1111111011101000111111101" \
      into rows
   put bitMatrix_new(25) into m
   set the itemDelimiter to comma
   repeat with r = 0 to 24
      put (item (r + 1) of rows) into rowStr
      repeat with c = 0 to 24
         if (char (c + 1) of rowStr) = "1" then
            bitMatrix_set m, c, r
         end if
      end repeat
   end repeat
   return m
end dec_fixtureHelloV2

command suite_detectorV2
   local tQR, tBig, tInfo, tTL, tTR, tBL, tDetRes, tBits, tDecRes
   local tPoints, tAlign, x, y, tEqual

   put dec_fixtureHelloV2() into tQR
   put det_upscale(tQR, 4, 4) into tBig          -- (25+8)*4 = 132
   t_eq "v2 synthetic image is 132x132", bitMatrix_getWidth(tBig), 132

   -- FinderPatternFinder: 3 corner centres
   put fpf_find(tBig, empty) into tInfo
   put tInfo["tl"] into tTL
   put tInfo["tr"] into tTR
   put tInfo["bl"] into tBL
   t_eq "v2 finder TL = (30,30)", (tTL["x"] & "," & tTL["y"]), "30,30"
   t_eq "v2 finder TR = (102,30)", (tTR["x"] & "," & tTR["y"]), "102,30"
   t_eq "v2 finder BL = (30,102)", (tBL["x"] & "," & tBL["y"]), "30,102"

   -- full Detector: dimension 25, alignment pattern found, sampled == original
   put dt_detect(tBig, empty) into tDetRes
   t_eq "v2 detect dimension = 25", tDetRes["dimension"], 25
   -- the 4th result point is the alignment pattern (module (18,18) -> px (90,90)).
   -- Use the long-form "is among the lines of the keys of ..." membership test.
   put tDetRes["points"] into tPoints
   t_eq "v2 alignment point present", ("3" is among the lines of the keys of tPoints), true
   put tPoints[3] into tAlign
   t_eq "v2 alignment x = 90", tAlign["x"], 90
   t_eq "v2 alignment y = 90", tAlign["y"], 90

   put tDetRes["bits"] into tBits
   t_eq "v2 sampled width = 25", bitMatrix_getWidth(tBits), 25
   put true into tEqual
   repeat with y = 0 to 24
      repeat with x = 0 to 24
         if bitMatrix_get(tBits, x, y) <> bitMatrix_get(tQR, x, y) then
            put false into tEqual
         end if
      end repeat
   end repeat
   t_eq "v2 sampled matrix == original", tEqual, true

   -- end-to-end: detect -> decode -> "HELLO WORLD"
   put dec_decode(tBits) into tDecRes
   t_eq "v2 decode error empty", tDecRes["error"], empty
   t_eq "v2 decode text = HELLO WORLD", tDecRes["text"], "HELLO WORLD"
   t_eq "v2 decode version = 2", tDecRes["version"], 2
   t_eq "v2 decode ecLevel = M", tDecRes["ecLevel"], "M"
end suite_detectorV2
?>
